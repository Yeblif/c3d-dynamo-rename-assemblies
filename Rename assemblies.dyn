    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "duplicate_unique_list_empty = IN[0]\r\nname_concat_string = IN[1]\r\n\r\n# message if any lists are empty\r\nany_if_empty = \"none\"\r\n\r\n# not changed list\r\nnot_changed_if_has_data = any_if_empty if duplicate_unique_list_empty[0] else str(name_concat_string[0])\r\n\r\nnot_changed_list = \"not changed: \\n\" + not_changed_if_has_data\r\n\r\n# changed list\r\nchanged_if_has_data = any_if_empty if duplicate_unique_list_empty[1] else str(name_concat_string[1])\r\n\r\nchanged_list = \"changed: \\n\" + changed_if_has_data\r\n\r\n# output message\r\nOUT = not_changed_list + \"\\n\\n\" + changed_list",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "9f78d7ff907b4ce9abc76c75f197e374",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "9424e3fc119a474ea457b50918b5d041",
          "Name": "duplicate_unique_list_empty",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "1fd6577c93fa4c3bbeccc178b690d9c2",
          "Name": "name_concat_string",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "c04fdc4a22484644a0d7a1b971149f39",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    }
